<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Album Art Generator</title>
    
    <!-- Load Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Load custom fonts for the album art -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Montserrat:wght@400;700;900&family=Permanent+Marker&family=Righteous&display=swap" rel="stylesheet">
    
    <style>
        /* Custom scrollbar and base aesthetics */
        body {
            background-color: #111827;
            color: #f3f4f6;
            font-family: 'Montserrat', sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        
        .glass-panel {
            background: rgba(31, 41, 55, 0.7);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Input styling overrides */
        input[type="text"], textarea, select {
            background: rgba(17, 24, 39, 0.8);
            border: 1px solid rgba(75, 85, 99, 0.6);
            color: white;
            transition: all 0.3s ease;
        }
        input[type="text"]:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.3);
        }
        
        /* Canvas container aspect ratio lock */
        .canvas-container {
            width: 100%;
            max-width: 600px;
            aspect-ratio: 1 / 1;
            margin: 0 auto;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
        }
        
        canvas {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        /* Loading spinner */
        .loader {
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-top: 3px solid #fff;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
            display: inline-block;
            vertical-align: middle;
            margin-right: 8px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="min-h-screen p-4 md:p-8">

    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <header class="text-center mb-8">
            <h1 class="text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500 mb-2 tracking-tight">Artifex</h1>
            <p class="text-gray-400 text-sm md:text-base">AI & Gallery Album Art Generator</p>
        </header>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Column: Controls (Order 2 on mobile, 1 on desktop) -->
            <div class="lg:col-span-5 space-y-6 order-2 lg:order-1">
                
                <!-- Text Data Section -->
                <div class="glass-panel p-6 rounded-2xl">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        Typography
                    </h2>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm text-gray-400 mb-1">Band / Artist Name</label>
                            <input type="text" id="band-name" placeholder="e.g. Mike Knotts & The State Line" class="w-full p-3 rounded-lg text-sm" oninput="drawCanvas()">
                        </div>
                        <div>
                            <label class="block text-sm text-gray-400 mb-1">Song / Album Name</label>
                            <input type="text" id="song-name" placeholder="Enter song name..." class="w-full p-3 rounded-lg text-sm" oninput="drawCanvas()">
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm text-gray-400 mb-1">Font Style</label>
                                <select id="font-select" class="w-full p-3 rounded-lg text-sm" onchange="drawCanvas()">
                                    <option value="Montserrat">Modern (Montserrat)</option>
                                    <option value="Cinzel">Classic (Cinzel)</option>
                                    <option value="Permanent Marker">Grungy (Marker)</option>
                                    <option value="Righteous">Retro (Righteous)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm text-gray-400 mb-1">Text Color</label>
                                <div class="flex items-center gap-2 p-1 bg-gray-800 rounded-lg border border-gray-600 h-[46px]">
                                    <input type="color" id="text-color" value="#ffffff" class="w-full h-full rounded cursor-pointer border-0 bg-transparent p-0 m-0" oninput="drawCanvas()">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Image Source Section (Tabs) -->
                <div class="glass-panel p-6 rounded-2xl">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        Cover Art Source
                    </h2>
                    
                    <!-- Tab Headers -->
                    <div class="flex bg-gray-800 rounded-lg p-1 mb-4">
                        <button id="tab-upload" class="flex-1 py-2 text-sm font-semibold rounded-md bg-gray-700 text-white shadow transition-all" onclick="switchTab('upload')">Gallery</button>
                        <button id="tab-ai" class="flex-1 py-2 text-sm font-semibold rounded-md text-gray-400 hover:text-white transition-all" onclick="switchTab('ai')">AI Generator</button>
                    </div>

                    <!-- Upload Tab Content -->
                    <div id="content-upload" class="block animate-fade-in">
                        <label class="block text-sm text-gray-400 mb-2">Upload from Device</label>
                        <div class="relative w-full h-32 border-2 border-dashed border-gray-600 rounded-lg hover:border-blue-400 transition-colors flex flex-col items-center justify-center cursor-pointer group bg-gray-800/50">
                            <svg class="w-8 h-8 text-gray-400 group-hover:text-blue-400 mb-2 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                            <span class="text-sm text-gray-400 group-hover:text-blue-400 transition-colors">Tap to select photo</span>
                            <!-- Hidden input, triggered by clicking the parent label/div -->
                            <input type="file" id="image-upload" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" onchange="handleImageUpload(event)">
                        </div>
                    </div>

                    <!-- AI Generator Tab Content -->
                    <div id="content-ai" class="hidden animate-fade-in">
                        <label class="block text-sm text-gray-400 mb-2">Describe your album cover</label>
                        <textarea id="ai-prompt" rows="3" placeholder="e.g. A neon glowing skull in a dark desert, retro synthwave style..." class="w-full p-3 rounded-lg text-sm mb-3 resize-none"></textarea>
                        
                        <button id="generate-btn" class="w-full py-3 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-bold rounded-lg shadow-lg transform transition-all active:scale-95 flex justify-center items-center" onclick="generateAIImage()">
                            <span id="generate-text">Generate AI Image</span>
                        </button>
                    </div>
                </div>

                <!-- Custom Message Box for Errors/Info -->
                <div id="message-box" class="hidden p-4 rounded-lg bg-red-900/50 border border-red-500 text-red-200 text-sm">
                    <!-- Message content goes here -->
                </div>

            </div>

            <!-- Right Column: Preview & Download (Order 1 on mobile, 2 on desktop) -->
            <div class="lg:col-span-7 flex flex-col items-center order-1 lg:order-2">
                
                <div class="w-full bg-gray-800/30 p-2 rounded-xl border border-gray-700 backdrop-blur-sm mb-6">
                    <div class="flex justify-between items-center px-4 py-2 border-b border-gray-700/50 mb-4">
                        <span class="text-sm font-semibold text-gray-300">Live Preview</span>
                        <span class="text-xs text-gray-500">1080 x 1080px</span>
                    </div>
                    
                    <!-- Canvas Container -->
                    <div class="canvas-container relative bg-black">
                        <!-- The high-res canvas (scaled down by CSS for view) -->
                        <canvas id="art-canvas" width="1080" height="1080"></canvas>
                        
                        <!-- Overlay loading state specifically for the canvas -->
                        <div id="canvas-overlay" class="absolute inset-0 bg-black/70 flex flex-col items-center justify-center hidden backdrop-blur-sm z-10">
                            <div class="loader mb-3 w-10 h-10 border-4 border-t-purple-500"></div>
                            <span class="text-purple-400 font-semibold tracking-wider">Dreaming up artwork...</span>
                        </div>
                    </div>
                </div>

                <button id="download-btn" class="w-full max-w-md py-4 bg-white text-gray-900 hover:bg-gray-200 font-bold rounded-xl shadow-[0_0_15px_rgba(255,255,255,0.2)] transform transition-all active:scale-95 flex justify-center items-center gap-2" onclick="downloadArt()">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Download Masterpiece
                </button>
                
            </div>
        </div>
    </div>

    <!-- Application Logic -->
    <script>
        // --- State and Constants ---
        const canvas = document.getElementById('art-canvas');
        const ctx = canvas.getContext('2d');
        const CANVAS_SIZE = 1080;
        let baseImage = null; // Stores the HTMLImageElement of the background
        
        // Use Gemini 3.1 Flash Image model for generating album art (as per guidelines for high fidelity images)
        const GEMINI_API_KEY = ""; // Provided automatically by the runtime environment
        const GEMINI_API_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${GEMINI_API_KEY}`;

        // Wait for fonts to load before initial draw to prevent flash of unstyled text
        document.fonts.ready.then(() => {
            drawCanvas();
        });

        // --- UI Interactions ---

        function switchTab(tabId) {
            const upTab = document.getElementById('tab-upload');
            const aiTab = document.getElementById('tab-ai');
            const upContent = document.getElementById('content-upload');
            const aiContent = document.getElementById('content-ai');

            if (tabId === 'upload') {
                upTab.className = "flex-1 py-2 text-sm font-semibold rounded-md bg-gray-700 text-white shadow transition-all";
                aiTab.className = "flex-1 py-2 text-sm font-semibold rounded-md text-gray-400 hover:text-white transition-all";
                upContent.classList.remove('hidden');
                aiContent.classList.add('hidden');
            } else {
                aiTab.className = "flex-1 py-2 text-sm font-semibold rounded-md bg-gray-700 text-white shadow transition-all";
                upTab.className = "flex-1 py-2 text-sm font-semibold rounded-md text-gray-400 hover:text-white transition-all";
                aiContent.classList.remove('hidden');
                upContent.classList.add('hidden');
            }
        }

        function showMessage(msg, isError = false) {
            const msgBox = document.getElementById('message-box');
            msgBox.textContent = msg;
            msgBox.className = `p-4 rounded-lg text-sm mb-4 ${isError ? 'bg-red-900/50 border border-red-500 text-red-200' : 'bg-blue-900/50 border border-blue-500 text-blue-200'}`;
            msgBox.classList.remove('hidden');
            
            // Auto hide after 5 seconds
            setTimeout(() => {
                msgBox.classList.add('hidden');
            }, 5000);
        }

        // --- File Upload Logic ---

        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    baseImage = img;
                    drawCanvas();
                }
                img.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }

        // --- AI Generation Logic (Gemini API) ---

        async function generateAIImage() {
            const prompt = document.getElementById('ai-prompt').value.trim();
            if (!prompt) {
                showMessage("Please enter a description for the AI.", true);
                return;
            }

            // Update UI for loading state
            const btn = document.getElementById('generate-btn');
            const btnText = document.getElementById('generate-text');
            const overlay = document.getElementById('canvas-overlay');
            
            btn.disabled = true;
            btnText.innerHTML = '<span class="loader"></span> Generating...';
            overlay.classList.remove('hidden');

            const payload = {
                contents: [{
                    role: 'user',
                    parts: [{ text: `Generate high quality, stylized album cover art without any text on the image. Subject: ${prompt}. Cinematic lighting, highly detailed, visually striking.` }]
                }],
                generationConfig: {
                    responseModalities: ['IMAGE'],
                    imageConfig: { aspectRatio: "1:1" }
                }
            };

            try {
                // Implementation includes exponential backoff retry logic as recommended
                let response = null;
                let retries = 0;
                let maxRetries = 3;
                let delay = 1000;

                while (retries < maxRetries) {
                    response = await fetch(GEMINI_API_URL, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) break;
                    if (response.status === 429) {
                        retries++;
                        await new Promise(r => setTimeout(r, delay));
                        delay *= 2;
                    } else {
                        throw new Error(`API Error: ${response.status}`);
                    }
                }

                if (!response || !response.ok) {
                    throw new Error("Failed to generate image after retries.");
                }

                const result = await response.json();
                const part = result?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);
                
                if (part && part.inlineData) {
                    const imageUrl = `data:${part.inlineData.mimeType};base64,${part.inlineData.data}`;
                    
                    const img = new Image();
                    img.onload = function() {
                        baseImage = img;
                        drawCanvas();
                    }
                    img.src = imageUrl;
                    showMessage("Image generated successfully!");
                } else {
                    throw new Error("Invalid response format from AI.");
                }

            } catch (error) {
                showMessage(error.message || "Failed to generate image. Please try again.", true);
            } finally {
                // Restore UI
                btn.disabled = false;
                btnText.innerHTML = 'Generate AI Image';
                overlay.classList.add('hidden');
            }
        }

        // --- Canvas Drawing Logic ---

        function drawCanvas() {
            // 1. Clear background
            ctx.fillStyle = '#0f172a'; // dark slate
            ctx.fillRect(0, 0, CANVAS_SIZE, CANVAS_SIZE);

            // 2. Draw Base Image if exists (Center crop to 1:1 aspect ratio)
            if (baseImage) {
                const scale = Math.max(CANVAS_SIZE / baseImage.width, CANVAS_SIZE / baseImage.height);
                const drawWidth = baseImage.width * scale;
                const drawHeight = baseImage.height * scale;
                const x = (CANVAS_SIZE - drawWidth) / 2;
                const y = (CANVAS_SIZE - drawHeight) / 2;
                
                ctx.drawImage(baseImage, x, y, drawWidth, drawHeight);
                
                // Add a subtle gradient overlay to ensure text is readable
                const gradient = ctx.createLinearGradient(0, 0, 0, CANVAS_SIZE);
                gradient.addColorStop(0, 'rgba(0,0,0,0.4)');
                gradient.addColorStop(0.3, 'rgba(0,0,0,0)');
                gradient.addColorStop(0.7, 'rgba(0,0,0,0)');
                gradient.addColorStop(1, 'rgba(0,0,0,0.6)');
                ctx.fillStyle = gradient;
                ctx.fillRect(0, 0, CANVAS_SIZE, CANVAS_SIZE);
            } else {
                // Default placeholder graphics if no image
                const grad = ctx.createLinearGradient(0, 0, CANVAS_SIZE, CANVAS_SIZE);
                grad.addColorStop(0, '#312e81'); // indigo-900
                grad.addColorStop(1, '#831843'); // pink-900
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, CANVAS_SIZE, CANVAS_SIZE);
                
                ctx.fillStyle = 'rgba(255,255,255,0.05)';
                ctx.beginPath();
                ctx.arc(CANVAS_SIZE/2, CANVAS_SIZE/2, 400, 0, Math.PI*2);
                ctx.fill();
            }

            // 3. Draw Typography
            const bandName = document.getElementById('band-name').value;
            const songName = document.getElementById('song-name').value;
            const fontFamily = document.getElementById('font-select').value;
            const textColor = document.getElementById('text-color').value;

            ctx.fillStyle = textColor;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            
            // Text Shadow for readability against busy backgrounds
            ctx.shadowColor = 'rgba(0, 0, 0, 0.8)';
            ctx.shadowBlur = 15;
            ctx.shadowOffsetX = 2;
            ctx.shadowOffsetY = 4;

            // Draw Band Name (Top area)
            if (bandName) {
                // Adjust font size based on string length to roughly fit
                let bandSize = 60;
                if (bandName.length > 20) bandSize = 45;
                if (bandName.length > 30) bandSize = 35;
                
                ctx.font = `${fontFamily === 'Montserrat' ? '900' : 'bold'} ${bandSize}px '${fontFamily}'`;
                ctx.fillText(bandName.toUpperCase(), CANVAS_SIZE / 2, 120);
                
                // Optional: Draw a thin line under band name
                ctx.shadowBlur = 0; // turn off shadow for line
                ctx.strokeStyle = textColor;
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(CANVAS_SIZE/2 - 100, 160);
                ctx.lineTo(CANVAS_SIZE/2 + 100, 160);
                ctx.stroke();
                // restore shadow
                ctx.shadowBlur = 15; 
            }

            // Draw Song Name (Bottom area)
            if (songName) {
                let songSize = 130;
                if (songName.length > 10) songSize = 100;
                if (songName.length > 15) songSize = 80;
                if (songName.length > 25) songSize = 60;

                ctx.font = `${fontFamily === 'Montserrat' ? '700' : 'bold'} ${songSize}px '${fontFamily}'`;
                
                // Word wrap logic for song title if it's too long
                if (songName.length > 15 && songName.includes(' ')) {
                    const words = songName.split(' ');
                    const half = Math.ceil(words.length / 2);
                    const line1 = words.slice(0, half).join(' ');
                    const line2 = words.slice(half).join(' ');
                    
                    ctx.fillText(line1, CANVAS_SIZE / 2, CANVAS_SIZE - 220);
                    ctx.fillText(line2, CANVAS_SIZE / 2, CANVAS_SIZE - 120);
                } else {
                    ctx.fillText(songName, CANVAS_SIZE / 2, CANVAS_SIZE - 150);
                }
            }

            // Reset shadow to not affect next frame
            ctx.shadowBlur = 0;
            ctx.shadowOffsetX = 0;
            ctx.shadowOffsetY = 0;
        }

        // --- Export / Download ---
        
        function downloadArt() {
            // Get data URL from canvas
            const dataURL = canvas.toDataURL('image/png');
            
            // Create a temporary link element
            const link = document.createElement('a');
            
            // Format filename
            let band = document.getElementById('band-name').value.replace(/[^a-z0-9]/gi, '_').toLowerCase();
            let song = document.getElementById('song-name').value.replace(/[^a-z0-9]/gi, '_').toLowerCase();
            let filename = 'album_art';
            if (band || song) {
                filename = `${band ? band : 'unknown'}_${song ? song : 'untitled'}_cover.png`;
            } else {
                filename += '.png';
            }

            link.download = filename;
            link.href = dataURL;
            
            // Trigger download
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
